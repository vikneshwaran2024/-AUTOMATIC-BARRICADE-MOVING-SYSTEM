
#include <ESP32Servo.h>

// Pin configuration
#define IR_ENTRY 18
#define IR_EXIT  19
#define SERVO_PIN 13

// Servo configuration
Servo barricade;

int openAngle = 90;
int closeAngle = 0;

// System states
int systemState = 0;

unsigned long detectionTime = 0;
const unsigned long timeout = 30000;

void setup() {

  Serial.begin(115200);

  pinMode(IR_ENTRY, INPUT_PULLUP);
  pinMode(IR_EXIT, INPUT_PULLUP);

  barricade.setPeriodHertz(50);
  barricade.attach(SERVO_PIN, 500, 2400);

  // Initially close barricade
  barricade.write(closeAngle);

  Serial.println("Smart Automatic Barricade");
  Serial.println("System Ready");
}

void loop() {

  int entrySensor = digitalRead(IR_ENTRY);
  int exitSensor = digitalRead(IR_EXIT);

  // STATE 0: Wait for vehicle
  if (systemState == 0) {

    if (entrySensor == LOW) {

      Serial.println("Vehicle Detected!");
      Serial.println("Opening Barricade");

      barricade.write(openAngle);

      detectionTime = millis();
      systemState = 1;

      delay(300);
    }
  }

  // STATE 1: Wait for vehicle to reach exit
  else if (systemState == 1) {

    if (exitSensor == LOW) {

      Serial.println("Vehicle Reached Exit Sensor");

      systemState = 2;
      delay(100);
    }
  }

  // STATE 2: Wait until vehicle clears exit sensor
  else if (systemState == 2) {

    if (exitSensor == HIGH) {

      Serial.println("Vehicle Passed Successfully");

      delay(1000);

      Serial.println("Closing Barricade");

      barricade.write(closeAngle);

      delay(1000);

      Serial.println("Barricade Closed");

      systemState = 0;
    }
  }

  // Safety timeout: keep barricade open if exit is not detected
  if (systemState != 0 &&
      millis() - detectionTime > timeout) {

    Serial.println("WARNING: Vehicle passage not confirmed");
    Serial.println("Barricade remains OPEN");

    systemState = 3;
  }

  // Manual reset is required after a timeout
  if (systemState == 3) {
    // Do not close automatically.
  }
}
